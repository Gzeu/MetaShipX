# MetaShipX Backend — Environment Variables
# Copy to .env and fill in your values

NODE_ENV=development
PORT=3001

# MultiversX
MX_API_URL=https://devnet-api.multiversx.com
MX_CHAIN=D

# Contract Addresses
BATTLESHIP_CONTRACT=erd1qqqqqqqqqqqqqpgq000000000000000000000000000000000000000000
NFT_CONTRACT=erd1qqqqqqqqqqqqqpgq000000000000000000000000000000000000000000
STAKING_CONTRACT=erd1qqqqqqqqqqqqqpgq000000000000000000000000000000000000000000
TOURNAMENT_CONTRACT=erd1qqqqqqqqqqqqqpgq000000000000000000000000000000000000000000

# CORS
CORS_ORIGIN=http://localhost:5173

# Cache TTL in seconds
CACHE_TTL=30

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=
