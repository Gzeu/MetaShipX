# MetaShipX Backend — Environment Variables
# Copy to .env.local and fill in real values
# NEVER commit .env.local to git

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── AUDIT: SESSION_SECRET must be >= 32 random characters
# Generate: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS_HERE

# ── AUDIT: CORS — comma-separated list of allowed frontend origins
# Dev: leave empty to allow all (NOT for production)
# Prod: ALLOWED_ORIGINS=https://metashipx.com,https://www.metashipx.com
ALLOWED_ORIGINS=

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://metashipx:password@localhost:5432/metashipx
# AUDIT: enable SSL in production
DATABASE_SSL=false

# ── MultiversX ──────────────────────────────────────────────────────────────
MX_API_URL=https://devnet-api.multiversx.com
MX_CHAIN_ID=D

# AUDIT: MultiversX Notifier ed25519 public key (64 hex chars)
# Get from your notifier config. Required for webhook signature validation.
# See: https://docs.multiversx.com/integrators/notifier
MX_NOTIFIER_PUBKEY=

# ── Admin ────────────────────────────────────────────────────────────────────
# AUDIT: Must be set in production. Protects /admin/* endpoints.
# Generate: openssl rand -hex 32
ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET

# ── Contract Addresses (auto-populated by mainnet-deploy.sh) ────────────────
BATTLESHIP_ADDRESS=
NFT_ADDRESS=
STAKING_ADDRESS=
MARKETPLACE_ADDRESS=
TOURNAMENT_ADDRESS=
LEADERBOARD_ADDRESS=
