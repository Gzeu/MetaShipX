# ─── MetaShipX Backend — copy to .env.local ───────────────────────────────
# Never commit .env.local to git

NODE_ENV=development
PORT=4000

# PostgreSQL — local: docker-compose; production: Railway/Supabase URL
DATABASE_URL=postgresql://metashipx:secret@localhost:5432/metashipx

# HMAC secret for MultiversX notifier webhook signature verification
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=change_me_generate_with_openssl_rand_hex_32

# Frontend URL for CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

# MultiversX contract addresses to monitor (used by mx-notifier)
BATTLESHIP_CONTRACT=erd1qqqqqqqqqqqqqpgq0000000000000000000000000000battleship00000
NFT_CONTRACT=erd1qqqqqqqqqqqqqpgq0000000000000000000000000000nft000000000000
STAKING_CONTRACT=erd1qqqqqqqqqqqqqpgq0000000000000000000000000000staking0000000

# mx-notifier config (run locally or point to devnet notifier)
# https://github.com/multiversx/mx-chain-notifier-go
NOTIFIER_URL=http://localhost:8080
