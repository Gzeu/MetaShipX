# MetaShipX Backend — Environment Variables
# Copy to .env.local and fill in real values

# ✅ AUDIT REQUIRED: must be >= 32 random chars in production
SESSION_SECRET=change-me-to-at-least-32-random-characters-here

# ✅ AUDIT REQUIRED: must be >= 16 chars in production
ADMIN_SECRET=change-me-admin-secret

# ✅ AUDIT REQUIRED: set to your frontend URL in production (no wildcard)
FRONTEND_URL=http://localhost:5173

# MultiversX webhook signature public key (from notifier config)
# Required in production for webhook signature verification
# MX_WEBHOOK_PUBKEY=<hex pubkey from mx-notifier config>

# Database
DATABASE_URL=postgresql://metashipx:password@localhost:5432/metashipx
# ✅ AUDIT: add ?sslmode=require in production
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# Server
PORT=4000
NODE_ENV=development

# Contract addresses (auto-generated by mainnet-deploy.sh)
VITE_BATTLESHIP_ADDRESS=
VITE_NFT_ADDRESS=
VITE_STAKING_ADDRESS=
VITE_MARKETPLACE_ADDRESS=
VITE_TOURNAMENT_ADDRESS=
VITE_LEADERBOARD_ADDRESS=
