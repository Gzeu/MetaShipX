# ─── MetaShipX — Devnet Environment ──────────────────────────────────────────
# Copy to .env.local and fill in deployed contract addresses.
# Never commit .env.local to git.

VITE_ENV=devnet

# MultiversX Devnet endpoints
VITE_API_URL=https://devnet-api.multiversx.com
VITE_GATEWAY_URL=https://devnet-gateway.multiversx.com
VITE_EXPLORER_URL=https://devnet-explorer.multiversx.com

# ─── Smart Contract Addresses (fill after deploy) ────────────────────────────
# mxpy contract deploy --bytecode contracts/battleship/output/battleship.wasm \
#   --pem wallet.pem --gas-limit 60000000 --chain D --proxy https://devnet-gateway.multiversx.com
VITE_BATTLESHIP_CONTRACT=erd1qqqqqqqqqqqqqpgq0000000000000000000000000000battleship00000

# mxpy contract deploy --bytecode contracts/nft/output/nft.wasm \
#   --pem wallet.pem --gas-limit 60000000 --chain D --proxy https://devnet-gateway.multiversx.com
VITE_NFT_CONTRACT=erd1qqqqqqqqqqqqqpgq0000000000000000000000000000nft000000000000

# mxpy contract deploy --bytecode contracts/staking/output/staking.wasm \
#   --pem wallet.pem --gas-limit 60000000 --chain D --proxy https://devnet-gateway.multiversx.com
VITE_STAKING_CONTRACT=erd1qqqqqqqqqqqqqpgq0000000000000000000000000000staking0000000

# ─── WebSocket / Webhook ─────────────────────────────────────────────────────
# Local dev: ngrok http 4000  →  copy the https URL below
# Production: your Railway/Render backend URL
VITE_WS_URL=ws://localhost:4000
VITE_WEBHOOK_URL=http://localhost:4000

# ─── WalletConnect v2 ────────────────────────────────────────────────────────
# Get a free project ID at https://cloud.walletconnect.com
VITE_WC_PROJECT_ID=7b9f8e2c4d1a0f3b6e9c2d5a8b1e4f7c
