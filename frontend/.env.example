# Application
VITE_APP_TITLE="MetaShipX"
VITE_APP_ENVIRONMENT=development

# API Configuration
VITE_APP_API_URL=http://localhost:3000/api

# Blockchain Configuration
VITE_APP_CHAIN_ID=D # D for devnet, T for testnet, 1 for mainnet

# WalletConnect
VITE_APP_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id

# Smart Contracts (update with your contract addresses)
VITE_APP_BATTLESHIP_CONTRACT_ADDRESS=erd1...
VITE_APP_NFT_CONTRACT_ADDRESS=erd1...
VITE_APP_STAKING_CONTRACT_ADDRESS=erd1...

# API Keys (if needed)
# VITE_APP_INFURA_ID=your_infura_id
# VITE_APP_ALCHEMY_KEY=your_alchemy_key

# Feature Flags
VITE_APP_ENABLE_ANALYTICS=false
VITE_APP_ENABLE_MAINTENANCE=false
