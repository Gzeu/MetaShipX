# MetaShipX Frontend — Environment Variables
# Copy this file to .env.local and fill in your contract addresses

# Environment: devnet | testnet | mainnet
VITE_ENV=devnet

# MultiversX API
VITE_API_URL=https://devnet-api.multiversx.com

# Backend API
VITE_BACKEND_URL=http://localhost:3001

# Smart Contract Addresses (filled automatically by deploy-devnet.sh)
VITE_BATTLESHIP_CONTRACT=erd1qqqqqqqqqqqqqpgq000000000000000000000000000000000000000000
VITE_NFT_CONTRACT=erd1qqqqqqqqqqqqqpgq000000000000000000000000000000000000000000
VITE_STAKING_CONTRACT=erd1qqqqqqqqqqqqqpgq000000000000000000000000000000000000000000
VITE_TOURNAMENT_CONTRACT=erd1qqqqqqqqqqqqqpgq000000000000000000000000000000000000000000
