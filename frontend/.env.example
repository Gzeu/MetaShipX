# ============================================================
# MetaShipX Frontend — Environment Variables
# ============================================================
# Copy to .env.local:
#   cp frontend/.env.example frontend/.env.local
#
# Fill in contract addresses after running deploy scripts.
# ============================================================

# ── Network ─────────────────────────────────────────────────
# Options: devnet | testnet | mainnet
VITE_NETWORK=devnet
VITE_MULTIVERSX_API=https://devnet-api.multiversx.com
VITE_MULTIVERSX_GATEWAY=https://devnet-gateway.multiversx.com

# ── Contract Addresses ───────────────────────────────────────
VITE_BATTLESHIP_ADDRESS=
VITE_NFT_ADDRESS=
VITE_STAKING_ADDRESS=
VITE_TOURNAMENT_ADDRESS=

# ── WalletConnect ──────────────────────────────────────────
# Get a free Project ID at https://cloud.walletconnect.com
VITE_WALLET_CONNECT_V2_PROJECT_ID=

# ── Backend ───────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
