# ============================================================
# MetaShipX — Environment Variables for Deployment
# ============================================================
# Copy this file to .env and fill in your values:
#   cp wallet/.env.example .env
#
# NEVER commit the actual .env file to git!
# ============================================================

# ── Network ──────────────────────────────────────────────────
# Options: devnet | testnet | mainnet
NETWORK=devnet

# MultiversX Gateway URLs
DEVNET_GATEWAY=https://devnet-gateway.multiversx.com
TESTNET_GATEWAY=https://testnet-gateway.multiversx.com
MAINNET_GATEWAY=https://gateway.multiversx.com

# ── Wallet ───────────────────────────────────────────────────
# Path to your deployer PEM wallet file (generated by scripts/generate-devnet-wallet.sh)
WALLET_PEM=./wallet/deployer.pem

# ── Deployed Contract Addresses ──────────────────────────────
# Populated automatically after running deploy scripts.
# You can also set them manually for existing deployments.
BATTLESHIP_CONTRACT_ADDRESS=
NFT_CONTRACT_ADDRESS=
STAKING_CONTRACT_ADDRESS=
TOURNAMENT_CONTRACT_ADDRESS=

# ── Frontend ─────────────────────────────────────────────────
# Copy these values to frontend/.env.local after deployment
NEXT_PUBLIC_BATTLESHIP_ADDRESS=${BATTLESHIP_CONTRACT_ADDRESS}
NEXT_PUBLIC_NFT_ADDRESS=${NFT_CONTRACT_ADDRESS}
NEXT_PUBLIC_STAKING_ADDRESS=${STAKING_CONTRACT_ADDRESS}
NEXT_PUBLIC_TOURNAMENT_ADDRESS=${TOURNAMENT_CONTRACT_ADDRESS}
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_API_URL=https://devnet-api.multiversx.com

# ── Backend ──────────────────────────────────────────────────
BACKEND_PORT=3001
JWT_SECRET=change_me_to_a_secure_random_string
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://user:password@localhost:5432/metashipx
